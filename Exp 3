        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.preprocessing import MinMaxScaler, LabelEncoder\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. LOAD DATASET\n",
        "# ============================================================\n",
        "\n",
        "df = pd.read_csv(\"earthquake.csv\")\n",
        "\n",
        "df.head()\n",
        "\n",
        "# ============================================================\n",
        "# 2. DATASET INFORMATION\n",
        "# ============================================================\n",
        "\n",
        "print(df.shape)\n",
        "\n",
        "df.info()\n",
        "\n",
        "# ============================================================\n",
        "# 3. CHECK MISSING VALUES\n",
        "# ============================================================\n",
        "\n",
        "print(\"Missing Values\\n\")\n",
        "\n",
        "print(df.isnull().sum())\n",
        "\n",
        "# ============================================================\n",
        "# 4. HANDLE NUMERICAL MISSING VALUES\n",
        "# ============================================================\n",
        "\n",
        "numeric_cols = df.select_dtypes(include=np.number).columns\n",
        "\n",
        "df[numeric_cols] = df[numeric_cols].fillna(\n",
        "    df[numeric_cols].median()\n",
        ")\n",
        "\n",
        "print(df.isnull().sum())\n",
        "\n",
        "# ============================================================\n",
        "# 5. HANDLE CATEGORICAL MISSING VALUES\n",
        "# ============================================================\n",
        "\n",
        "categorical_cols = df.select_dtypes(\n",
        "    include=\"object\"\n",
        ").columns\n",
        "\n",
        "for col in categorical_cols:\n",
        "    df[col] = df[col].fillna(\n",
        "        df[col].mode()[0]\n",
        "    )\n",
        "\n",
        "print(\"Missing values after cleaning:\\n\")\n",
        "print(df.isnull().sum())\n",
        "\n",
        "# ============================================================\n",
        "# 6. DUPLICATE ROWS\n",
        "# ============================================================\n",
        "\n",
        "print(\"Duplicate Rows :\", df.duplicated().sum())\n",
        "\n",
        "df.drop_duplicates(inplace=True)\n",
        "\n",
        "print(\"After Removal :\", df.shape)\n",
        "\n",
        "# ============================================================\n",
        "# 7. OUTLIER DETECTION - EARTHQUAKE MAGNITUDE\n",
        "# ============================================================\n",
        "\n",
        "Q1 = df[\"Magnitude\"].quantile(0.25)\n",
        "Q3 = df[\"Magnitude\"].quantile(0.75)\n",
        "\n",
        "IQR = Q3 - Q1\n",
        "\n",
        "lower = Q1 - 1.5 * IQR\n",
        "upper = Q3 + 1.5 * IQR\n",
        "\n",
        "outliers = df[\n",
        "    (df[\"Magnitude\"] < lower) |\n",
        "    (df[\"Magnitude\"] > upper)\n",
        "]\n",
        "\n",
        "print(\"Number of outliers:\", len(outliers))\n",
        "\n",
        "print(outliers.head())\n",
        "\n",
        "# ============================================================\n",
        "# 8. MAGNITUDE BOXPLOT\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "sns.boxplot(x=df[\"Magnitude\"])\n",
        "\n",
        "plt.title(\"Earthquake Magnitude Outliers\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# 9. INFLATION OUTLIERS\n",
        "# ============================================================\n",
        "\n",
        "Q1 = df[\"Inflation\"].quantile(0.25)\n",
        "Q3 = df[\"Inflation\"].quantile(0.75)\n",
        "\n",
        "IQR = Q3 - Q1\n",
        "\n",
        "lower = Q1 - 1.5 * IQR\n",
        "upper = Q3 + 1.5 * IQR\n",
        "\n",
        "inflation_outliers = df[\n",
        "    (df[\"Inflation\"] < lower) |\n",
        "    (df[\"Inflation\"] > upper)\n",
        "]\n",
        "\n",
        "print(\"Inflation Outliers:\")\n",
        "print(inflation_outliers.head())\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "sns.boxplot(x=df[\"Inflation\"])\n",
        "\n",
        "plt.title(\"Inflation Outliers\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# 10. NORMALIZATION\n",
        "# ============================================================\n",
        "\n",
        "scaler = MinMaxScaler()\n",
        "\n",
        "numeric_cols = df.select_dtypes(\n",
        "    include=np.number\n",
        ").columns\n",
        "\n",
        "df[numeric_cols] = scaler.fit_transform(\n",
        "    df[numeric_cols]\n",
        ")\n",
        "\n",
        "print(df[numeric_cols].head())\n",
        "\n",
        "# ============================================================\n",
        "# 11. LABEL ENCODING\n",
        "# ============================================================\n",
        "\n",
        "encoder = LabelEncoder()\n",
        "\n",
        "if \"Country\" in df.columns:\n",
        "\n",
        "    df[\"Country\"] = encoder.fit_transform(\n",
        "        df[\"Country\"]\n",
        "    )\n",
        "\n",
        "print(df.head())\n",
        "\n",
        "# ============================================================\n",
        "# 12. ONE-HOT ENCODING\n",
        "# ============================================================\n",
        "\n",
        "if \"Country\" in df.columns:\n",
        "\n",
        "    country = pd.get_dummies(\n",
