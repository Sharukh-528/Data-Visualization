        "    bins=30,\n",
        "    kde=True\n",
        ")\n",
        "\n",
        "plt.title(\"Inflation Distribution\")\n",
        "\n",
        "plt.xlabel(\"Inflation Rate\")\n",
        "\n",
        "plt.show()\n",
        "sns.pairplot(\n",
        "    df[\n",
        "        [\n",
