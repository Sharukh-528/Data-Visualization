        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "df = pd.read_csv(\"earthquake.csv\")\n",
        "\n",
        "print(df.head())\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "sns.scatterplot(\n",
        "    data=df,\n",
        "    x=\"Magnitude\",\n",
        "    y=\"Inflation\"\n",
        ")\n",
        "\n",
        "plt.title(\"Earthquake Magnitude vs Inflation\")\n",
        "plt.xlabel(\"Earthquake Magnitude\")\n",
        "plt.ylabel(\"Inflation Rate\")\n",
        "\n",
        "plt.show()\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "sns.boxplot(\n",
        "    x=df[\"Inflation\"]\n",
        ")\n",
        "\n",
        "plt.title(\"Inflation Outlier Detection\")\n",
        "plt.xlabel(\"Inflation Rate\")\n",
        "\n",
        "plt.show()\n",
        "plt.figure(figsize=(10,8))\n",
        "\n",
        "corr = df[\n",
        "    [\n",
        "        \"Inflation\",\n",
        "        \"Magnitude\",\n",
        "        \"Depth\",\n",
        "        \"Latitude\",\n",
        "        \"Longitude\"\n",
        "    ]\n",
        "].corr()\n",
        "\n",
        "sns.heatmap(\n",
        "    corr,\n",
        "    annot=True,\n",
        "    cmap=\"coolwarm\"\n",
        ")\n",
        "\n",
        "plt.title(\"Earthquake and Inflation Correlation Heatmap\")\n",
        "\n",
        "plt.show()\n",
        "def inflation_category(value):\n",
        "\n",
        "    if value < 2:\n",
        "        return \"Low\"\n",
        "\n",
        "    elif value < 5:\n",
        "        return \"Moderate\"\n",
        "\n",
        "    elif value < 10:\n",
        "        return \"High\"\n",
        "\n",
        "    else:\n",
        "        return \"Very High\"\n",
        "\n",
        "\n",
        "df[\"Inflation_Category\"] = df[\"Inflation\"].apply(\n",
        "    inflation_category\n",
        ")\n",
        "\n",
        "print(df[[\"Inflation\", \"Inflation_Category\"]].head())\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "sns.countplot(\n",
        "    data=df,\n",
        "    x=\"Inflation_Category\"\n",
        ")\n",
        "\n",
        "plt.title(\"Inflation Categories\")\n",
        "\n",
        "plt.xlabel(\"Inflation Category\")\n",
        "plt.ylabel(\"Number of Records\")\n",
        "\n",
        "plt.show()\n",
        "yearly = df.groupby(\"Year\")[\"Inflation\"].mean()\n",
        "\n",
        "plt.figure(figsize=(12,5))\n",
        "\n",
        "plt.plot(\n",
        "    yearly.index,\n",
        "    yearly.values,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.title(\"Average Inflation Over Time\")\n",
        "\n",
        "plt.xlabel(\"Year\")\n",
        "plt.ylabel(\"Average Inflation\")\n",
        "\n",
        "plt.grid()\n",
        "\n",
        "plt.show()\n",
        "inflation = df[\"Inflation_Category\"].value_counts()\n",
        "\n",
        "plt.figure(figsize=(8,8))\n",
        "\n",
        "plt.pie(\n",
        "    inflation,\n",
        "    labels=inflation.index,\n",
        "    autopct=\"%1.1f%%\",\n",
        "    startangle=90\n",
        ")\n",
        "\n",
        "plt.title(\"Inflation Category Distribution\")\n",
        "\n",
        "plt.show()\n",
        "country = df.groupby(\"Country\")[\"Inflation\"].mean()\n",
        "\n",
        "country = country.sort_values(\n",
        "    ascending=False\n",
        ").head(10)\n",
        "\n",
        "plt.figure(figsize=(10,5))\n",
        "\n",
        "country.plot(kind=\"bar\")\n",
        "\n",
        "plt.title(\"Top 10 Countries by Average Inflation\")\n",
        "\n",
        "plt.xlabel(\"Country\")\n",
        "plt.ylabel(\"Average Inflation\")\n",
        "\n",
        "plt.show()\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "sns.histplot(\n",
